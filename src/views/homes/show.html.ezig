<% const view_helpers = @import("app").view_helpers; %>
<% _ = props; %>
<div data-react-component-name="AnimatedBackground"></div>
<div class="grow flex flex-col items-center justify-center font-[Comic_Relief,sans] text-blue-700 dark:text-blue-400 px-10 py-4">
  <h1 class="<%= view_helpers.container_class %> font-bold text-3xl">Charlie is turning 13!!!!</h1>
  <div class="<%= view_helpers.container_class %> mt-4">
    <p>Celebrate with us!</p>
    <p>
      <a
        href="https://maps.app.goo.gl/Y8g9HZjD7pJm2bq89"
        class="<%= view_helpers.link_class %>"
      >
        Shaka Shaka Tiki
      </a>
    </p>
    <p>💕 Saturday, Feb. 14 💕</p>
    <p>8pm 'til late</p>
  </div>
</div>
